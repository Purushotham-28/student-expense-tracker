# ==========================================
# Student Expense Tracker Environment Config
# ==========================================

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-placeholder
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=student_expense_tracker
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: Full Database Connection URL (e.g. mysql://user:password@host:port/dbname)
# DATABASE_URL=mysql://root:your_mysql_password_here@127.0.0.1:3306/student_expense_tracker

# Frontend Origins (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Anthropic Claude API Key (for expense classification & smart insights)
CLAUDE_API_KEY=sk-ant-api-placeholder-never-commit-real-secrets
